# Copy to .env in sstation-next/ for docker compose (optional — defaults work for local smoke tests).
# Never commit .env with real production passwords.

# Postgres (docker-compose.yml db + app services)
POSTGRES_PASSWORD=sstation_dev_only

# Prod / external Postgres (also used when SPRING_PROFILES_ACTIVE=prod)
SSTATION_DB_URL=jdbc:postgresql://db:5432/sstation
SSTATION_DB_USER=sstation
SSTATION_DB_PASSWORD=sstation_dev_only

# SMTP — leave unset or empty for log-only notifications
# SSTATION_MAIL_HOST=
# SSTATION_MAIL_PORT=587
# SSTATION_MAIL_USER=
# SSTATION_MAIL_PASSWORD=
# SSTATION_MAIL_FROM=no-reply@austincollege.edu

# First administrator on a bare `prod` boot against an empty database (TC-121).
# Required only on the very first start — the runner is gated on the users table being empty, so
# it never runs again. The account is created flagged and must change this password at first
# sign-in. Not used when the demo profile is active. See "First login" in ../DEPLOY.md.
# SSTATION_BOOTSTRAP_ADMIN_USERNAME=admin
# SSTATION_BOOTSTRAP_ADMIN_PASSWORD=

# Demo showcase passwords (docker-compose.yml prod,demo — TC-114; required on any public host, no admin_secret)
SSTATION_DEMO_ADMIN_PASSWORD=changeme-demo-admin
SSTATION_DEMO_STUDENT_PASSWORD=changeme-demo-student
SSTATION_DEMO_MODERATOR_PASSWORD=changeme-demo-moderator

# Dev seed passwords (docker-compose.dev.yml / gradlew bootRun only)
# SSTATION_DEV_ADMIN_PASSWORD=admin_secret
# SSTATION_DEV_STUDENT_PASSWORD=student_secret
# SSTATION_DEV_MODERATOR_PASSWORD=moderator_secret
